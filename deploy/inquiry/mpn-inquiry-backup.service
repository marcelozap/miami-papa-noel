[Unit]
Description=Miami Papa Noel private SQLite backup
After=mpn-inquiry.service

[Service]
Type=oneshot
User=mpn-inquiry
Group=mpn-inquiry
WorkingDirectory=/opt/miami-papa-noel
EnvironmentFile=/etc/miami-papa-noel/inquiry.env
Environment=PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=OPENAI_API_KEY MPN_MODEL MPN_OPERATOR_TOKEN
ExecStart=/usr/bin/python3 /opt/miami-papa-noel/tools/web_inquiry/maintenance.py backup --database ${MPN_INQUIRY_DIR}/inquiries.sqlite3 --backup-dir /var/lib/miami-papa-noel/backups
TimeoutStartSec=120
UMask=0077
LimitCORE=0
StateDirectory=miami-papa-noel
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/miami-papa-noel
RestrictAddressFamilies=AF_UNIX
