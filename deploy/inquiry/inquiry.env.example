# Copy to /etc/miami-papa-noel/inquiry.env, owned by root, mode 0600.
# Replace the origin with the approved HTTPS hostname. Empty token fails startup.
MPN_PUBLIC_ORIGIN=https://inquiry.example.invalid
MPN_TRUSTED_PROXY_IP=127.0.0.1
MPN_INQUIRY_DIR=/var/lib/miami-papa-noel/inquiry-demo
MPN_OPERATOR_TOKEN=
# Leave empty to serve the plain form only. Generate with
# python -c "import secrets;print(secrets.token_hex(32))" to enable the
# public chat widget; keep it identical across restarts and workers.
MPN_CHAT_SECRET=
# Leave unset/0. Only set to 1 after separate owner approval to enable the
# gated model path inside the chat widget; the existing call cap and
# estimated-cost guard below still apply either way.
MPN_CHAT_ALLOW_MODEL=
# Configure these privately only for an authorized model-backed synthetic test.
# The initial service uses --offline, which disables API calls even if set.
OPENAI_API_KEY=
MPN_MODEL=
