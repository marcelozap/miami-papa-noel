# Copy to /etc/miami-papa-noel/inquiry.env, owned by root, mode 0600.
# Replace the origin with the approved HTTPS hostname. Empty token fails startup.
MPN_PUBLIC_ORIGIN=https://inquiry.example.invalid
MPN_TRUSTED_PROXY_IP=127.0.0.1
MPN_INQUIRY_DIR=/var/lib/miami-papa-noel/inquiry-demo
MPN_OPERATOR_TOKEN=
# Configure these privately only for an authorized model-backed synthetic test.
# The initial service uses --offline, which disables API calls even if set.
OPENAI_API_KEY=
MPN_MODEL=
