[Unit]
Description=Miami Papa Noel storage health and draft-failure check
After=mpn-inquiry.service

[Service]
Type=oneshot
User=mpn-inquiry
Group=mpn-inquiry
WorkingDirectory=/opt/miami-papa-noel
EnvironmentFile=/etc/miami-papa-noel/inquiry.env
Environment=PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=OPENAI_API_KEY MPN_MODEL
ExecStart=/usr/bin/python3 /opt/miami-papa-noel/deploy/inquiry/healthcheck.py
TimeoutStartSec=25
UMask=0077
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_UNIX
